[Unit]
Description=Arrosage web UI (vite preview)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jnfrm
Group=jnfrm
WorkingDirectory=/home/jnfrm/projects/arrosage/arrosage-web
Environment=NODE_ENV=production
ExecStart=/home/jnfrm/.nvm/versions/node/v22.20.0/bin/node ./node_modules/vite/bin/vite.js preview --host --port 5173
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
